# Copia este archivo a .env.local y completa con tu propia API key.
# Nunca subas .env.local a GitHub (ya está en .gitignore).

# Tu Bearer Token de Groq (https://console.groq.com/keys)
GROQ_API_KEY=tu_api_key_aqui

# Modelo a usar. llama-3.1-8b-instant es la familia Llama 3.x actualmente
# disponible en el plan gratuito de Groq.
# NOTA: Groq anuncio la baja de este modelo para el 16/08/2026, con
# openai/gpt-oss-20b como reemplazo recomendado. Si deja de funcionar,
# cambia solo este valor.
GROQ_MODEL=llama-3.1-8b-instant
